{
  "name": "archiplan",
  "private": true,
  "version": "0.1.0",
  "description": "Diseñador local de arquitecturas de soluciones con reglas, capas C4, plantillas y exportación",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
